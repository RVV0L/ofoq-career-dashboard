# انسخ هذا الملف إلى .env.local واملأ القيم (من Supabase: Project Settings > API)
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...   # مفتاح anon/publishable العام فقط. لا تضع service_role هنا أبداً
# اختياري: إظهار زر الدخول عبر Google بعد تفعيله في Supabase
VITE_ENABLE_GOOGLE=false
